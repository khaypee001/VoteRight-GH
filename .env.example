# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted App URL
APP_URL="MY_APP_URL"

# =============================================================================
# SUPABASE CONFIGURATION (Local Dev & Production Deployments)
# =============================================================================

# For Vite Apps / Client-Side React (Local & Build):
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# For Next.js & Vercel Dashboard Environment Variables:
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Service Role Key (Keep Secret! Use only in Server/API contexts, never expose to browser):
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# =============================================================================
# PAYSTACK PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Secret Key (Server-Only context! Never expose in browser bundle):
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# Public Key (Client & Build):
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
